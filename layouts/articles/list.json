{{ $articles := slice }}
{{ range .Pages }}
{{ $event := dict
  "title" .Title
  "url" (.Params.url | default .RelPermalink)
}}
{{ if .Params.debut }}
{{ $event = merge $event (dict
  "start" .Params.debut
  "end" (.Params.fin | default "")
) }}
{{ end }}
{{ $articles = $articles | append $event }}
{{ end }}
{{ $articles | jsonify }}
